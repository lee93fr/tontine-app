APP_NAME="TontineApp"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tontine
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=votre-login-brevo@exemple.com
MAIL_PASSWORD=votre-cle-smtp-brevo
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tontine@votredomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

QUEUE_CONNECTION=sync

# SMS Brevo — valeurs par défaut, surchargeables via l'interface superadmin
SMS_ENABLED=false
BREVO_SMS_API_KEY=
BREVO_SMS_SENDER=Tontine
BREVO_SMS_TYPE=transactional

# Web Push (VAPID) - ne jamais exposer VAPID_PRIVATE_KEY cote frontend
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"
